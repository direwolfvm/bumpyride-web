# Local dev: matches docker-compose.yml
DATABASE_URL=postgres://bumpyride:bumpyride@localhost:5432/bumpyride

# Cloud Run + Cloud SQL (Unix socket) — set in the service's env, not here:
# DATABASE_URL=postgres://USER:PASSWORD@/DBNAME?host=/cloudsql/PROJECT:REGION:INSTANCE

# Optional: HTTP port. Cloud Run injects PORT automatically.
PORT=8080

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=replace-me-with-a-32-byte-random-string

# Behind Cloud Run / any reverse proxy, set this so cookies use the right host.
# AUTH_URL=https://your-cloud-run-url.run.app

# Google OAuth — create at https://console.cloud.google.com/apis/credentials
# Authorised redirect URI: <AUTH_URL>/api/auth/callback/google
# Leave blank to disable the Google sign-in button.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Minimum sample count before a 20 ft cell appears on the public bump map
# (default 3). Single-rider solo routes won't publish until cells are
# reinforced by other contributors.
# PUBLIC_BUMPMAP_MIN_COUNT=3

# Google Analytics 4 measurement id (e.g. G-XXXXXXXXXX). Optional —
# when unset, no analytics script is served at all.
#
# Intentionally NOT prefixed NEXT_PUBLIC_: Next inlines NEXT_PUBLIC_*
# at build time, so a runtime value would be ignored. This is read
# per-request in the root layout, so setting it on Cloud Run takes
# effect without rebuilding. See src/components/Analytics.tsx.
GA_MEASUREMENT_ID=
